# Контекст сборки не должен тянуть в образ то, что нужно только для разработки.

# VCS и служебные файлы
.git
.gitignore

# Документация и лицензия — не нужны в runtime-образе
*.md
LICENSE

# Секреты: .env попадает в образ ТОЛЬКО через переменные окружения compose.
# Исключение для .env.example — чтобы был виден список переменных.
.env
.env.*
!.env.example

# Инфраструктура и деплой — в образах приложения не нужны
docker/
k8s/
docs/
tests/

# Артефакты сборки и покрытия
cover.out
cover.html
bin/
*.exe

# OS-мусор
.DS_Store
Thumbs.db
